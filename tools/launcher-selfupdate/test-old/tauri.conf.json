{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RE-CREATED Launcher",
  "version": "0.1.2",
  "identifier": "city.create.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RE:CREATED Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": ["icons/icon.ico"]
  }
}
