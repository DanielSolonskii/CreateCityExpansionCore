recreated.ru {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"

	@publicLauncher {
		method GET HEAD
		path /api/launcher/server-status /api/launcher/news
	}
	handle @publicLauncher {
		reverse_proxy 127.0.0.1:8080
	}

	handle /downloads/macos.json {
		root * /opt/create-server/distribution/launcher/macos-aarch64/latest
		rewrite * /update.json
		header Cache-Control no-cache
		file_server
	}
	handle {
		root * /srv/recreated-site/current
		file_server
	}
}
