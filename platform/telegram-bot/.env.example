# Reference only; Gradle/Java do not automatically load .env.
# Set TELEGRAM_BOT_TOKEN and BOT_BACKEND_SECRET in the process environment.
TELEGRAM_BOT_USERNAME=your_create_server_bot
BACKEND_URL=http://127.0.0.1:8080
# Set to the permanent production HTTPS installer/download page URL before release.
# Empty disables the download link, not the registration/verification flow.
LAUNCHER_DOWNLOAD_URL=
# Optional Windows-specific override. If present (even empty), replaces the legacy URL.
# LAUNCHER_WINDOWS_DOWNLOAD_URL=
# Separate macOS installer/download page. Never falls back to the Windows URL.
LAUNCHER_MACOS_DOWNLOAD_URL=
