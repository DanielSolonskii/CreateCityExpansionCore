[Unit]
Description=Create Server Backend
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=createserver
Group=createserver
WorkingDirectory=/opt/create-server/backend
EnvironmentFile=/opt/create-server/secrets/backend.env
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java -Xms128m -Xmx384m -jar /opt/create-server/backend/app.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=768M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
