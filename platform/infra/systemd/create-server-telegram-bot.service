[Unit]
Description=Create Server Telegram Bot (configure real secrets before enabling)
Wants=network-online.target
After=network-online.target create-server-backend.service
ConditionPathExists=/opt/create-server/secrets/telegram-bot.env
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=createserver
Group=createserver
WorkingDirectory=/opt/create-server/telegram-bot
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
Environment="JAVA_OPTS=-Xms32m -Xmx128m"
EnvironmentFile=/opt/create-server/secrets/telegram-bot.env
ExecStart=/opt/create-server/telegram-bot/bin/create-server-telegram-bot
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=384M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
